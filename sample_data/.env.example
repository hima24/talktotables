# Copy this file to .env and fill in the keys you have. Never commit .env.

# Claude models (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Open-weight models via Groq, free tier available (https://console.groq.com)
GROQ_API_KEY=

# Optional settings
# DEFAULT_MODEL=claude-haiku
# MAX_QUESTIONS_PER_SESSION=20
# MAX_UPLOAD_MB=25
# ENABLE_LOCAL_MODELS=1   # show Ollama models (needs Ollama running locally)
