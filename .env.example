# Copy to .env or set these in PowerShell: $env:ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-haiku
# Show the local open-source model in the app's model picker (needs Ollama running)
ENABLE_LOCAL_MODELS=0
OLLAMA_MODEL=qwen2.5-coder:7b
MAX_QUESTIONS_PER_SESSION=10
# Optional: send agent-mode runs to LangSmith for tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=talktotables
